 "domKeys": {
  "update": {
   "tokens": 14,
   "key": [],
   "event": [],
   "text": "Business update: a rival hive keeps following my scouts to my best flower field."
  },
  "scouts": {
   "tokens": 10,
   "key": [],
   "event": [],
   "text": "I move the scouts, they follow, and I move again."
  },
  "gameSent": {
   "tokens": 16,
   "key": [
    3,
    4,
    5,
    6,
    7,
    8
   ],
   "event": [],
   "text": "It has become a game of cat and mouse that wastes time for both of us."
  },
  "gameExample": {
   "tokens": 24,
   "key": [
    6,
    7,
    8,
    9,
    10,
    11
   ],
   "event": [],
   "text": "In the yard, the children played a game of cat and mouse, with one pretending to be the cat and the other the mouse."
  },
  "consumedLead": {
   "tokens": 9,
   "key": [
    2,
    3,
    4
   ],
   "event": [],
   "text": "Worse, I was consumed with spying on their queen,"
  },
  "consumedExample": {
   "tokens": 8,
   "key": [
    1,
    2,
    3
   ],
   "event": [],
   "text": "She was consumed with guilt after the accident."
  },
  "consumedRest": {
   "tokens": 9,
   "key": [],
   "event": [],
   "text": "so I forgot to check my own honey sales."
  },
  "napping": {
   "tokens": 4,
   "key": [],
   "event": [],
   "text": "She, meanwhile, was napping."
  }
 },
