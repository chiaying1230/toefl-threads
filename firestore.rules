rules_version = '2';

// Security rules for TOEFL Threads.
// Firebase console → Firestore Database → Rules → paste this file → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The write changes only these fields, each by exactly -1, 0 or +1.
    function counterStep(fields) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(fields)
        && (!('likes' in fields) || (request.resource.data.get('likes', 0) - resource.data.get('likes', 0)) in [-1, 0, 1])
        && (!('replies' in fields) || (request.resource.data.get('replies', 0) - resource.data.get('replies', 0)) in [-1, 0, 1])
        && (!('reposts' in fields) || (request.resource.data.get('reposts', 0) - resource.data.get('reposts', 0)) in [-1, 0, 1]);
    }

    // Each person's likes, saved words, preferences and streak. Private.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Threads written by people. Everyone can read; only the author can create or delete.
    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.likes == 0
        && request.resource.data.replies == 0
        && request.resource.data.get('reposts', 0) == 0
        && (!('quoteOf' in request.resource.data) || (request.resource.data.quoteOf is string && request.resource.data.quoteOf.size() <= 40))
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && counterStep(['likes', 'replies', 'reposts']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Shared like/reply counters for the built-in character threads.
    match /postStats/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['likes', 'replies', 'reposts'])
        && request.resource.data.get('likes', 0) in [0, 1]
        && request.resource.data.get('replies', 0) in [0, 1]
        && request.resource.data.get('reposts', 0) in [0, 1];
      allow update: if signedIn() && counterStep(['likes', 'replies', 'reposts']);
    }

    // Reposts: one document per person per thread, id "<uid>_<postId>". Everyone can read
    // (people who follow you see your reposts); only you can add or remove your own.
    match /reposts/{repostId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postId.size() <= 40
        && repostId == request.auth.uid + '_' + request.resource.data.postId
        && request.resource.data.keys().hasOnly(['uid', 'postId', 'name', 'handle', 'avatar', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.handle is string && request.resource.data.handle.size() <= 24
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 16
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Weekly leaderboard: one score per person per week. Everyone can read;
    // people can only write their own score, within sane limits.
    match /weeks/{week}/scores/{uid} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && week.matches('^[0-9]{4}-W[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'points', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 16
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        && request.resource.data.points <= 1000
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Public profile: name, username, bio, avatar emoji or a small photo. Everyone can read.
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'handle', 'avatar', 'photo', 'bio', 'target', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.handle is string && request.resource.data.handle.size() <= 24
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 16
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 160
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 60000
        && (request.resource.data.photo == '' || request.resource.data.photo.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'))
        && request.resource.data.target is int && request.resource.data.target >= 0 && request.resource.data.target <= 120
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Where to send someone's push notifications, and which kinds they want. Private.
    match /pushTokens/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['tokens', 'prefs', 'tz', 'updatedAt'])
        && request.resource.data.tokens is list && request.resource.data.tokens.size() <= 10
        && request.resource.data.prefs is map
        && request.resource.data.tz is int;
    }

    // Bookkeeping for the notification sender (GitHub Actions uses an admin key).
    // No app user can read or write it.
    match /notifyState/{doc} {
      allow read, write: if false;
    }

    // Replies. Everyone can read; only the author can create or delete.
    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
