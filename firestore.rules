rules_version = '2';

// Security rules for toEfu.
// Firebase console → Firestore Database → Rules → paste this file → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function threadDoc(coll, postId) {
      return /databases/$(database)/documents/$(coll)/$(postId);
    }

    function limitsDoc() {
      return /databases/$(database)/documents/limits/$(request.auth.uid);
    }

    // Text field of a sane length.
    function str(v, max) {
      return v is string && v.size() <= max;
    }

    // The public name/handle/avatar copied onto posts, replies and reposts.
    function authorFields(d) {
      return str(d.name, 40) && str(d.handle, 24) && str(d.avatar, 16);
    }

    // ---------- Counters (likes / replies / reposts) ----------
    // Each change is exactly -1, 0 or +1 and must come with its proof in the same batch:
    //   likes ±1   → your likes/{uid}_{postId} record is created / deleted
    //   reposts ±1 → your reposts/{uid}_{postId} record is created / deleted
    //   replies +1 → you just wrote a reply (limits.comment set to now, at most one every 10 s)
    //   replies −1 → you just deleted one (limits.uncomment set to now, at most one every 2 s)
    function delta(old, f) {
      return request.resource.data.get(f, 0) - old.get(f, 0);
    }

    function recordToggled(coll, postId, d) {
      let rec = /databases/$(database)/documents/$(coll)/$(request.auth.uid + '_' + postId);
      return (d != 1 || (!exists(rec) && existsAfter(rec)))
        && (d != -1 || (exists(rec) && !existsAfter(rec)));
    }

    function counterChange(old, postId) {
      let d = request.resource.data;
      let dl = delta(old, 'likes');
      let dr = delta(old, 'replies');
      let dp = delta(old, 'reposts');
      return signedIn()
        && dl in [-1, 0, 1] && dr in [-1, 0, 1] && dp in [-1, 0, 1]
        && d.get('likes', 0) >= 0 && d.get('replies', 0) >= 0 && d.get('reposts', 0) >= 0
        && recordToggled('likes', postId, dl)
        && recordToggled('reposts', postId, dp)
        && (dr != 1 || getAfter(limitsDoc()).data.get('comment', null) == request.time)
        && (dr != -1 || getAfter(limitsDoc()).data.get('uncomment', null) == request.time);
    }

    // Counter value of a thread before / after this write (posts/{id} or postStats/{id}).
    function countBefore(coll, postId, f) {
      return exists(threadDoc(coll, postId)) ? get(threadDoc(coll, postId)).data.get(f, 0) : 0;
    }
    function countAfter(coll, postId, f) {
      return existsAfter(threadDoc(coll, postId)) ? getAfter(threadDoc(coll, postId)).data.get(f, 0) : 0;
    }

    // ---------- Rate limits ----------
    // limits/{uid} holds when you last posted, replied, deleted a reply or reported.
    // Each field can only be set to "now", and only after a pause.
    function throttled(f, secs) {
      return !(f in request.resource.data.diff(resource.data).affectedKeys())
        || (request.resource.data[f] == request.time
            && (!(f in resource.data) || request.time > resource.data[f] + duration.value(secs, 's')));
    }

    match /limits/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['post', 'comment', 'uncomment', 'report'])
        && request.resource.data.values().hasOnly([request.time]);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['post', 'comment', 'uncomment', 'report'])
        && throttled('post', 30) && throttled('comment', 10) && throttled('uncomment', 2) && throttled('report', 10);
    }

    // Each person's likes, saved words, preferences and streak. Private.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Threads written by people. Everyone can read; only the author can create or delete.
    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'handle', 'avatar', 'text', 'quoteOf', 'likes', 'replies', 'reposts', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && authorFields(request.resource.data)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.likes == 0
        && request.resource.data.replies == 0
        && request.resource.data.get('reposts', 0) == 0
        && (!('quoteOf' in request.resource.data) || str(request.resource.data.quoteOf, 40))
        && request.resource.data.createdAt == request.time
        && getAfter(limitsDoc()).data.get('post', null) == request.time;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'replies', 'reposts'])
        && counterChange(resource.data, postId);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Shared like/reply/repost counters for the built-in character threads.
    match /postStats/{postId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['likes', 'replies', 'reposts'])
        && counterChange({}, postId);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'replies', 'reposts'])
        && counterChange(resource.data, postId);
    }

    // One record per person per liked thread, id "<uid>_<postId>". Private.
    // Adding or removing one must move the thread's like counter in the same batch.
    match /likes/{likeId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'postId', 'coll', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.postId, 40)
        && request.resource.data.coll in ['posts', 'postStats']
        && likeId == request.auth.uid + '_' + request.resource.data.postId
        && request.resource.data.createdAt == request.time
        && countAfter(request.resource.data.coll, request.resource.data.postId, 'likes') == countBefore(request.resource.data.coll, request.resource.data.postId, 'likes') + 1;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && (countAfter(resource.data.coll, resource.data.postId, 'likes') == countBefore(resource.data.coll, resource.data.postId, 'likes') - 1
            || !existsAfter(threadDoc(resource.data.coll, resource.data.postId)));
    }

    // Reposts: one record per person per thread, id "<uid>_<postId>". Everyone can read
    // (people who follow you see your reposts); only you can add or remove your own,
    // and the thread's repost counter moves with it.
    match /reposts/{repostId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'postId', 'coll', 'name', 'handle', 'avatar', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.postId, 40)
        && request.resource.data.coll in ['posts', 'postStats']
        && repostId == request.auth.uid + '_' + request.resource.data.postId
        && authorFields(request.resource.data)
        && request.resource.data.createdAt == request.time
        && countAfter(request.resource.data.coll, request.resource.data.postId, 'reposts') == countBefore(request.resource.data.coll, request.resource.data.postId, 'reposts') + 1;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && (!('coll' in resource.data)
            || countAfter(resource.data.coll, resource.data.postId, 'reposts') == countBefore(resource.data.coll, resource.data.postId, 'reposts') - 1
            || !existsAfter(threadDoc(resource.data.coll, resource.data.postId)));
    }

    // Replies. Everyone can read; only the author can create or delete.
    // At most one reply every 10 seconds, and the thread's reply counter moves with it.
    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['postId', 'coll', 'uid', 'name', 'handle', 'avatar', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.postId, 40)
        && request.resource.data.coll in ['posts', 'postStats']
        && authorFields(request.resource.data)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt == request.time
        && getAfter(limitsDoc()).data.get('comment', null) == request.time
        && countAfter(request.resource.data.coll, request.resource.data.postId, 'replies') == countBefore(request.resource.data.coll, request.resource.data.postId, 'replies') + 1;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Reports of threads or replies. Anyone signed in can file one (one every 10 seconds);
    // nobody can read them in the app — review them in the Firebase console.
    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'kind', 'targetId', 'postId', 'authorUid', 'reason', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['post', 'comment']
        && str(request.resource.data.targetId, 40)
        && str(request.resource.data.postId, 40)
        && str(request.resource.data.authorUid, 128)
        && request.resource.data.reason in ['spam', 'harassment', 'inappropriate', 'other']
        && str(request.resource.data.text, 500)
        && request.resource.data.createdAt == request.time
        && getAfter(limitsDoc()).data.get('report', null) == request.time;
    }

    // Public profile: name, username, bio, avatar emoji or a small photo. Everyone can read.
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'handle', 'avatar', 'photo', 'bio', 'target', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.handle is string && request.resource.data.handle.size() <= 24
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 16
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 160
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 60000
        && (request.resource.data.photo == '' || request.resource.data.photo.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'))
        && request.resource.data.target is int && request.resource.data.target >= 0 && request.resource.data.target <= 120
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Where to send someone's push notifications, and which kinds they want. Private.
    match /pushTokens/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['tokens', 'prefs', 'tz', 'updatedAt'])
        && request.resource.data.tokens is list && request.resource.data.tokens.size() <= 10
        && request.resource.data.prefs is map
        && request.resource.data.tz is int;
    }

    // ---------- Vocabulary quiz (/quiz) ----------
    // quizRuns: one anonymous result per finished quiz. Anyone can add one; nobody can read, change or delete them
    // (the daily reconcile job reads them with an admin key).
    function quizAnswers(a) {
      return a is list && a.size() == 15;
    }

    function quizRunOk(d) {
      return d.keys().hasOnly(['date', 'createdAt', 'device', 'attempt_no', 'is_best', 'self_estimate', 'challenge',
                               'vocab', 'theta', 'correct', 'total_ms', 'answers', 'source', 'qv'])
        && d.keys().hasAll(['date', 'createdAt', 'device', 'attempt_no', 'is_best', 'vocab', 'theta', 'correct', 'total_ms', 'answers'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.createdAt == request.time
        && str(d.device, 40) && d.device.size() >= 8
        && d.attempt_no is int && d.attempt_no >= 1 && d.attempt_no <= 999
        && d.is_best is bool
        && (!('self_estimate' in d) || d.self_estimate == null || (d.self_estimate is int && d.self_estimate >= 0 && d.self_estimate <= 11000))
        && (!('challenge' in d) || d.challenge == null
            || (d.challenge is map && d.challenge.keys().hasOnly(['rival_vocab', 'rival_sec', 'won'])
                && d.challenge.rival_vocab is int && d.challenge.rival_vocab >= 0 && d.challenge.rival_vocab <= 11000
                && d.challenge.rival_sec is int && d.challenge.rival_sec >= 0 && d.challenge.rival_sec <= 9999
                && (d.challenge.won == null || d.challenge.won is bool)))
        && d.vocab is int && d.vocab >= 0 && d.vocab <= 11000
        && d.theta is number && d.theta >= -10 && d.theta <= 10
        && d.correct is int && d.correct >= 0 && d.correct <= 15
        && d.total_ms is int && d.total_ms >= 5000 && d.total_ms <= 200000
        && quizAnswers(d.answers)
        && (!('source' in d) || str(d.source, 20))
        && (!('qv' in d) || str(d.qv, 20));
    }

    match /quizRuns/{runId} {
      allow read, update, delete: if false;
      allow create: if str(runId, 40) && runId.size() >= 8 && quizRunOk(request.resource.data);
    }

    // quizNotes: how a player says they chose a word (asked before the score is shown, for some players only).
    // Anyone can add one, nobody can read, change or delete them (the reconcile job reads them with an admin key).
    // The id is "<run>_<word>", so a word can be noted once per run, and the run (and its device) must already exist.
    function quizNoteOk(noteId, d) {
      return d.keys().hasOnly(['run', 'device', 'word', 'picked', 'result', 'ms', 'reason', 'other_word', 'createdAt'])
        && d.keys().hasAll(['run', 'device', 'word', 'picked', 'result', 'ms', 'reason', 'createdAt'])
        && str(d.run, 40) && d.run.size() >= 8
        && str(d.word, 40) && d.word.size() >= 1
        && noteId == d.run + '_' + d.word
        && str(d.device, 40) && d.device.size() >= 8
        && str(d.picked, 40)
        && d.result in ['correct', 'wrong']
        && d.ms is int && d.ms >= 0 && d.ms <= 60000
        && d.reason in ['sure', 'torn', 'lookalike', 'affix', 'forgot', 'guess', 'misclick']
        && (!('other_word' in d) || (d.reason == 'lookalike' && str(d.other_word, 30) && d.other_word.size() >= 1))
        && d.createdAt == request.time
        && exists(/databases/$(database)/documents/quizRuns/$(d.run))
        && get(/databases/$(database)/documents/quizRuns/$(d.run)).data.device == d.device;
    }

    match /quizNotes/{noteId} {
      allow read, update, delete: if false;
      allow create: if quizNoteOk(noteId, request.resource.data);
    }

    // ---------- Review quiz (Review tab → Quiz, docs/review-quiz-spec.md) ----------
    // reviewRuns: one anonymous round (1–10 answers) from someone's own saved words. reviewNotes: how they say they
    // chose a word in that round. Same pattern as quizRuns/quizNotes: anyone can add, nobody can read, change or
    // delete (the reconcile job reads them with an admin key), and a note's round (and its device) must exist.
    function reviewRunOk(d) {
      return d.keys().hasOnly(['device', 'date', 'source', 'qv', 'correct', 'answers', 'createdAt'])
        && d.keys().hasAll(['device', 'date', 'correct', 'answers', 'createdAt'])
        && str(d.device, 40) && d.device.size() >= 8
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('source' in d) || str(d.source, 20))
        && (!('qv' in d) || str(d.qv, 20))
        && d.answers is list && d.answers.size() >= 1 && d.answers.size() <= 10
        && d.correct is int && d.correct >= 0 && d.correct <= d.answers.size()
        && d.createdAt == request.time;
    }

    match /reviewRuns/{runId} {
      allow read, update, delete: if false;
      allow create: if str(runId, 40) && runId.size() >= 8 && reviewRunOk(request.resource.data);
    }

    function reviewNoteOk(noteId, d) {
      return d.keys().hasOnly(['run', 'device', 'word', 'picked', 'result', 'ms', 'reason', 'other_word', 'box', 'createdAt'])
        && d.keys().hasAll(['run', 'device', 'word', 'picked', 'result', 'ms', 'reason', 'box', 'createdAt'])
        && str(d.run, 40) && d.run.size() >= 8
        && str(d.word, 60) && d.word.size() >= 1
        && noteId == d.run + '_' + d.word
        && str(d.device, 40) && d.device.size() >= 8
        && str(d.picked, 60)
        && d.result in ['correct', 'wrong']
        && d.ms is int && d.ms >= 0 && d.ms <= 60000
        && d.reason in ['sure', 'torn', 'lookalike', 'affix', 'forgot', 'guess', 'misclick']
        && (!('other_word' in d) || (d.reason == 'lookalike' && str(d.other_word, 30) && d.other_word.size() >= 1))
        && d.box is int && d.box >= 0 && d.box <= 20
        && d.createdAt == request.time
        && exists(/databases/$(database)/documents/reviewRuns/$(d.run))
        && get(/databases/$(database)/documents/reviewRuns/$(d.run)).data.device == d.device;
    }

    match /reviewNotes/{noteId} {
      allow read, update, delete: if false;
      allow create: if reviewNoteOk(noteId, request.resource.data);
    }

    // quizStats/all and quizStats/day-YYYY-MM-DD: live distribution counters, one field per
    // (vocabulary bucket of 100 words, time bucket of 10 seconds, capped at 120 s): "v<bucket>_t<bucket>".
    // Everyone can read. A write may only add exactly 1 to the one field that matches a quizRuns document
    // created in the same batch, add 1 to n, and set last to that document's id.
    function quizTimeBucket(ms) {
      return ms >= 120000 ? 12 : int(math.floor(ms / 10000));
    }

    function quizField(run) {
      return 'v' + string(int(math.floor(run.vocab / 100))) + '_t' + string(quizTimeBucket(run.total_ms));
    }

    function quizRunRef(id) {
      return /databases/$(database)/documents/quizRuns/$(id);
    }

    function quizStatId(docId) {
      return docId == 'all' || docId.matches('^day-[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Does this stats write belong to the run named in `last` (created in this very batch)?
    function quizRunMatches(docId, d) {
      let ref = quizRunRef(d.last);
      return str(d.last, 40)
        && !exists(ref) && existsAfter(ref)
        && (docId == 'all' || docId == 'day-' + getAfter(ref).data.date)
        && quizDayNear(docId);
    }

    // The day document's date is within a day of the server time.
    function quizDayNear(docId) {
      let p = docId.split('-');
      return docId == 'all' || (
        timestamp.date(int(p[1]), int(p[2]), int(p[3])) <= request.time + duration.value(1, 'd')
        && timestamp.date(int(p[1]), int(p[2]), int(p[3])) >= request.time - duration.value(1, 'd'));
    }

    match /quizStats/{docId} {
      allow read: if true;
      allow create: if quizStatId(docId)
        && request.resource.data.keys().hasOnly([quizField(getAfter(quizRunRef(request.resource.data.last)).data), 'n', 'last'])
        && request.resource.data.keys().hasAll(['n', 'last'])
        && request.resource.data.n == 1
        && request.resource.data[quizField(getAfter(quizRunRef(request.resource.data.last)).data)] == 1
        && quizRunMatches(docId, request.resource.data);
      allow update: if quizStatId(docId)
        && quizRunMatches(docId, request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([quizField(getAfter(quizRunRef(request.resource.data.last)).data), 'n', 'last'])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasAll([quizField(getAfter(quizRunRef(request.resource.data.last)).data), 'n', 'last'])
        && request.resource.data.n == resource.data.get('n', 0) + 1
        && request.resource.data[quizField(getAfter(quizRunRef(request.resource.data.last)).data)]
             == resource.data.get(quizField(getAfter(quizRunRef(request.resource.data.last)).data), 0) + 1;
      allow delete: if false;
    }

    // Bookkeeping for the notification sender (GitHub Actions uses an admin key).
    // No app user can read or write it.
    match /notifyState/{docId} {
      allow read, write: if false;
    }

    // Lets setup.html tell which version of these rules is published:
    // reading meta/rules-v10 is allowed (404 "not found") only with this version.
    match /meta/{name} {
      allow read: if name == 'rules-v10';
    }
  }
}
